---
import Prose from '../components/Prose.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Sprite from '../components/Sprite.astro';
import Page from './Page.astro';

// The layout of a policy written in markdown (src/pages/privacy.md, terms.md): the landing page's
// header and footer around one readable column.
type Props = {
  frontmatter: {
    title: string;
    description: string;
    // The date the text last changed, as a reader reads it ("13 November 2026").
    updated: string;
  };
};

const { title, description, updated } = Astro.props.frontmatter;
---

<Page title={`${title} · YOZZ`} description={description}>
  <Sprite />
  <SiteHeader />
  <main id="main" tabindex="-1" class="wrap">
    <article>
      <p class="label">Legal</p>
      <h1 class="section-title">{title}</h1>
      <p class="updated">Last updated {updated}</p>
      <Prose class="body">
        <slot />
      </Prose>
    </article>
  </main>
  <SiteFooter />
</Page>

<style>
  main {
    padding-block: clamp(48px, 7vw, 104px) clamp(72px, 9vw, 136px);
  }

  article {
    max-width: 42rem;
  }

  .updated {
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.25rem;
    color: var(--text-faint);
  }

  .body {
    margin-top: clamp(36px, 5vw, 56px);
  }
</style>
