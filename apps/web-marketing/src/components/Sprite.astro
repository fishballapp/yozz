---
// The shapes the page draws more than once, defined once and drawn with <use>. Icons are a
// 24-unit grid of 1.5 strokes, as the app's Phosphor set reads at 13-15px.
---

<svg width="0" height="0" class="absolute" aria-hidden="true">
  <defs>
    <mask id="wordmark-cut">
      <rect x="-200" y="-200" width="800" height="800" fill="#fff"></rect>
      <rect x="-200" y="46.5" width="800" height="7" fill="#000"></rect>
    </mask>
    <!-- apps/web/src/ui/Wordmark.tsx: the same letters, in the text colour, as the rail draws it. -->
    <symbol id="wordmark" viewBox="0 0 340 100">
      <g mask="url(#wordmark-cut)" transform="translate(18 0) skewX(-10)" fill="currentColor" fill-rule="evenodd">
        <path d="M0 0H26L38 30L50 0H76L51 58V100H25V58Z"></path>
        <path transform="translate(80 0)" d="M0 0H76V100H0ZM26 26H50V74H26Z"></path>
        <path transform="translate(160 0)" d="M0 0H76V26L36 74H76V100H0V74L40 26H0Z"></path>
        <path transform="translate(240 0)" d="M0 0H76V26L36 74H76V100H0V74L40 26H0Z"></path>
      </g>
    </symbol>
    <symbol id="i-star" viewBox="0 0 24 24"><path d="M12 3.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.2-4.1 5.8-.8z"></path></symbol>
    <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"></path></symbol>
    <symbol id="i-tray" viewBox="0 0 24 24"><path d="M4 5h16v14H4zM4 14h4.5l1.5 2.5h4l1.5-2.5H20"></path></symbol>
    <symbol id="i-send" viewBox="0 0 24 24"><path d="M20.5 3.5L3.5 9.8l6.6 3.1 3.1 6.6zM10.1 12.9l4.2-4.2"></path></symbol>
    <symbol id="i-file" viewBox="0 0 24 24"><path d="M6 3.5h8l4 4v13H6zM14 3.5v4h4"></path></symbol>
    <symbol id="i-archive" viewBox="0 0 24 24"><path d="M3.5 5h17v4h-17zM5 9v10h14V9M10 13h4"></path></symbol>
    <symbol id="i-trash" viewBox="0 0 24 24"><path d="M4.5 6.5h15M9 6.5V4h6v2.5M6.5 6.5l.8 13.5h9.4l.8-13.5"></path></symbol>
    <symbol id="i-gear" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"></circle><path d="M12 3.5v3M12 17.5v3M3.5 12h3M17.5 12h3M6 6l2.1 2.1M15.9 15.9L18 18M18 6l-2.1 2.1M8.1 15.9L6 18"></path></symbol>
    <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"></circle><path d="M16 16l4.5 4.5"></path></symbol>
    <symbol id="i-clip" viewBox="0 0 24 24"><path d="M19 11.5l-7.2 7.2a4.2 4.2 0 01-6-6L13.5 5a2.8 2.8 0 014 4l-7.6 7.6a1.4 1.4 0 01-2-2L14.5 8"></path></symbol>
    <symbol id="i-reply" viewBox="0 0 24 24"><path d="M9.5 7L4.5 12l5 5M4.5 12H14a5.5 5.5 0 015.5 5.5V19"></path></symbol>
    <symbol id="i-forward" viewBox="0 0 24 24"><path d="M14.5 7l5 5-5 5M19.5 12H10A5.5 5.5 0 004.5 17.5V19"></path></symbol>
    <symbol id="i-mail" viewBox="0 0 24 24"><path d="M3.5 5.5h17v13h-17zM3.5 6.5L12 13l8.5-6.5"></path></symbol>
    <symbol id="i-close" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"></path></symbol>
    <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"></path></symbol>
    <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M4 12h15M13 6l6 6-6 6" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter"></path></symbol>
  </defs>
</svg>
