# YOZZ API worker — environment schema (varlock + 1Password).
#
# Safe to commit: references the worker 1Password Environment by id, never values. Used by the
# deploy pipeline (scripts/deploy-worker.ts) and `db:migrate:remote`; local `wrangler dev` reads
# .dev.vars instead.
#
# @defaultRequired=true
# @defaultSensitive=true
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_TOKEN, allowAppAuth=true, cacheTtl=1d)
# @setValuesBulk(opLoadEnvironment(5jpgwoooiasxejgm7hpkj5wzl4))
# ---

# 1Password service-account token — secret-zero (CI only; local uses the desktop app).
# @type=opServiceAccountToken @required=false
OP_TOKEN=

# Cloudflare DEPLOY token (Workers Scripts: Edit + D1: Edit) — authenticates wrangler deploy,
# secret-prune API calls, and `db:migrate:remote`. NOT a Worker runtime secret (deliberately
# absent from scripts/secret-keys.json).
CLOUDFLARE_API_TOKEN=

# --- Worker runtime secrets (uploaded by scripts/deploy-worker.ts; must match scripts/secret-keys.json) ---
# Better Auth signing/encryption secret (generate once: `openssl rand -base64 32`).
BETTER_AUTH_SECRET=
# forwardemail.net alias password for no-reply@yozz.app (magic-link emails).
FORWARD_EMAIL_ALIAS_PASSWORD=
