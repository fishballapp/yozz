{
  "name": "@yozz.app/web",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "YOZZ zero-knowledge webmail SPA \u2014 a multi-account client for addresses users already own. YOZZ's servers cannot read mail or credentials; existing mail providers remain unchanged.",
  "exports": {
    "./signed-in": "./src/vault/signed-in.ts",
    "./tokens.css": "./src/styles/tokens.css"
  },
  "scripts": {
    "dev": "vite --port 5177",
    "build": "vite build",
    "preview": "vite preview --port 5177",
    "test": "vitest run --passWithNoTests",
    "html:security": "node harness/html-security.ts",
    "vault:drive": "node harness/vault-drive.ts",
    "draft:drive": "node harness/draft-open.ts",
    "attachments:drive": "pnpm -F @yozz.app/cli build && node harness/attachment-drive.ts",
    "og:inbox": "node scripts/build-og-inbox.ts",
    "og": "node scripts/build-og-inbox.ts && node scripts/build-og.ts"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@better-auth/passkey": "catalog:",
    "@fontsource-variable/geist": "catalog:",
    "@fontsource-variable/geist-mono": "catalog:",
    "@phosphor-icons/react": "catalog:",
    "@tanstack/markdown": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "@yozz.app/imap": "workspace:*",
    "@yozz.app/mail": "workspace:*",
    "@yozz.app/smtp": "workspace:*",
    "@yozz.app/tls": "workspace:*",
    "@yozz.app/vault": "workspace:*",
    "@yozz.app/vault-contract": "workspace:*",
    "@yozz.app/x509": "workspace:*",
    "better-auth": "catalog:",
    "cn": "catalog:",
    "class-variance-authority": "catalog:",
    "react": "catalog:web",
    "react-dom": "catalog:web",
    "temporal-polyfill": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@internal/html-screenshot": "workspace:*",
    "@internal/vite-plugins": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:web",
    "@types/react-dom": "catalog:web",
    "@vitejs/plugin-react": "catalog:",
    "fake-indexeddb": "catalog:",
    "jsdom": "catalog:",
    "postal-mime": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
