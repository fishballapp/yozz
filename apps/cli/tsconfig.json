{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "composite": true,
    "lib": ["ESNext", "DOM"],
    "types": ["node"],
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.tsbuildinfo"
