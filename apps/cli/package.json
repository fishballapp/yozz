{
  "name": "@yozz.app/cli",
  "version": "0.1.2",
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "yozz: the mail in your YOZZ account, from a terminal, for coding agents and the person beside them.",
  "homepage": "https://yozz.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fishballapp/yozz.git",
    "directory": "apps/cli"
  },
  "bin": {
    "yozz": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm build",
    "cli": "pnpm build && node dist/bin.js",
    "test": "vitest run",
    "check:effect": "effect-tsgo diagnostics --project tsconfig.json --format text"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@fishballapps/cli-login": "workspace:*",
    "@types/node": "catalog:",
    "@yozz.app/imap": "workspace:*",
    "@yozz.app/mail": "workspace:*",
    "@yozz.app/smtp": "workspace:*",
    "@yozz.app/vault": "workspace:*",
    "@yozz.app/vault-contract": "workspace:*",
    "effect": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
