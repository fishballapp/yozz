# YOZZ web (assets-only) Worker — environment schema (varlock + 1Password).
#
# Safe to commit: references the worker 1Password Environment by id, never values. The SPA host
# has NO runtime secrets — it only needs the Cloudflare DEPLOY token to authenticate `wrangler
# deploy`. So we deliberately declare ONLY that token (+ the CI service-account token): varlock
# loads the deploy credential and nothing else, so none of the Better Auth / forwardemail
# runtime secrets in that Environment reach this assets deploy. Same narrow deploy token the
# api-worker uses (Workers Scripts: Edit) — both workers live in one Cloudflare account.
#
# @defaultRequired=true
# @defaultSensitive=true
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_TOKEN, allowAppAuth=true, cacheTtl=1d)
# @setValuesBulk(opLoadEnvironment(5jpgwoooiasxejgm7hpkj5wzl4))
# ---

# 1Password service-account token — secret-zero (CI only; local uses the desktop app).
# @type=opServiceAccountToken @required=false
OP_TOKEN=

# Cloudflare DEPLOY token (Workers Scripts: Edit) — authenticates `wrangler deploy`. NOT a Worker
# runtime secret; worker-web ships no Worker secrets (assets-only).
CLOUDFLARE_API_TOKEN=
