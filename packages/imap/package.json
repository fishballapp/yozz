{
  "name": "@yozz.app/imap",
  "version": "0.1.1",
  "description": "Transport-agnostic IMAP4rev2/rev1 client core: literals, total parsing, RFC 2047, SASL PLAIN/LOGIN, IDLE, UID MOVE.",
  "license": "MIT",
  "homepage": "https://github.com/fishballapp/yozz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fishballapp/yozz.git",
    "directory": "packages/imap"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "prepack": "pnpm build",
    "test": "vitest run",
    "live": "node harness/live.ts"
  },
  "dependencies": {
    "@yozz.app/tls": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@yozz.app/x509": "workspace:*",
    "tsdown": "catalog:"
  }
}
