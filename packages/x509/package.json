{
  "name": "@yozz.app/x509",
  "version": "0.1.0",
  "description": "Strict DER, X.509 certificate decoding and RFC 5280 path validation in TypeScript, with a compiled trust store. Runs in Node and browsers, no native code.",
  "license": "MIT",
  "homepage": "https://github.com/fishballapp/yozz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fishballapp/yozz.git",
    "directory": "packages/x509"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "prepack": "pnpm build",
    "corpus:harvest": "node corpus/harvest.ts",
    "limbo:fetch": "node harness/fetch.ts",
    "limbo": "node harness/limbo.ts",
    "test": "vitest run --passWithNoTests",
    "limbo:ours": "node harness/limbo.ts --validator=yozz",
    "anchors:fetch": "node anchors/fetch.ts",
    "anchors:build": "node anchors/build.ts",
    "anchors:check": "node anchors/upstream-check.ts"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:"
  }
}
