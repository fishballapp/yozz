{
  "name": "@yozz.app/tls",
  "version": "0.1.0",
  "description": "A TLS 1.3 client in TypeScript over any byte duplex: record layer, handshake, key schedule, PSK resumption, KeyUpdate, TOFU pinning. Runs in Node and browsers, no native code.",
  "license": "MIT",
  "homepage": "https://github.com/fishballapp/yozz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fishballapp/yozz.git",
    "directory": "packages/tls"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./harness": "./harness/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "prepack": "pnpm build",
    "test": "vitest run",
    "live": "node harness/live.ts",
    "browser": "node harness/browser/run.ts",
    "bogo:fetch": "node harness/bogo/fetch.ts",
    "bogo:inventory": "node harness/bogo/run.ts --inventory",
    "bogo": "node harness/bogo/run.ts",
    "bogo:record": "node harness/bogo/run.ts --update"
  },
  "dependencies": {
    "@yozz.app/x509": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "vite": "catalog:",
    "wrangler": "catalog:"
  }
}
